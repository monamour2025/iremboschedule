# Database (Neon: pooled for app, unpooled for migrations)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Irembo API
IREMBO_SERVICE="PRACTICAL_EXAM"
IREMBO_BENEFICIARIES="PrivateCandidate"
IREMBO_LOCATIONS=""
IREMBO_CATEGORIES="A,A1,B,B1,C,D,D1,E,F"
IREMBO_LOCATION_CONCURRENCY=10

# Worker
SCAN_INTERVAL_MINUTES=5
APPLICANT_MATCH_INTERVAL_SECONDS=5

# Dashboard / API
SCHEDULES_API_LIMIT=3000

# Priority alerts — BUSANZA AUTOMATED CENTER is scanned via Irembo district "Kicukiro"
PRIORITY_CATEGORY="A"
PRIORITY_CENTER="BUSANZA AUTOMATED CENTER"
PRIORITY_LOCATION="Kicukiro"

# Notifications
ALERT_EMAIL=""
ALERT_PHONE=""
NOTIFICATION_WEBHOOK_URL=""
RESEND_API_KEY=""
RESEND_FROM="onboarding@resend.dev"

# Optional: if set, dashboard Scan now must send x-scan-secret header
SCAN_API_SECRET=""

# Vercel Cron (required on Vercel — set the same value in Project → Environment Variables)
# Vercel sends Authorization: Bearer <CRON_SECRET> to /api/cron/tick every 5 minutes
CRON_SECRET=""

# DDL Application Automation
# On Vercel set AUTOMATION_MODE=production so live applications are submitted
AUTOMATION_MODE="production"
AUTOMATION_CONCURRENCY=3
APPLICANT_AUTOMATION_COOLDOWN_MS=3000
IREMBO_RATE_LIMIT_COOLDOWN_MS=120000
PROFILE_LOOKUP_INTERVAL_MS=3000
IREMBO_PROFILE_RATE_LIMIT_WAIT_MS=15000
IREMBO_PROFILE_423_RETRIES=1
# Optional fallback entity ID — do NOT auto-apply to all applicants; set per person in Edit if profile lookup fails
DEFAULT_IREMBO_ENTITY_ID="da39aca5-e4cc-4edd-8df8-0e09399b1793"
# Choose your own password here, then enter the same value in the DDL Admin page once.
ADMIN_API_SECRET=""
ENCRYPTION_KEY=""
REDIS_URL=""
AUTOMATION_QUEUE_NAME="irembo-ddl-automation"
IREMBO_BASE_URL="https://irembo.gov.rw/irembo/rest/public"
# Optional fallbacks if Irembo rate-limits anonymous profile lookups from your IP
IREMBO_USERNAME=""
IREMBO_PASSWORD=""
IREMBO_OTP=""
IREMBO_CITIZEN_COOKIE=""
